# Kopyalayın: cp .env.example .env  (.env asla Git'e eklenmez)

# Yapay zekâ planlayıcıları (isteğe bağlı, ücretli, kullanım başına). Hiçbiri tanımlı değilse
# ücretsiz çevrimdışı planlayıcı kullanılır. İkisi de tanımlıysa arayüzden seçilir.

# Qwen (Alibaba Cloud Model Studio / DashScope). DASHSCOPE_API_KEY adı da kabul edilir.
QWEN_API_KEY=
# Varsayılan: qwen-plus. Daha güçlü: qwen-max, daha ucuz: qwen-flash
QWEN_MODEL=qwen-plus
# Uluslararası bölge varsayılandır. Çin bölgesi hesapları için:
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Ücretsiz bir kurum içi sunucu kullanıyorsanız false yapın; arayüzdeki "Ücretli" etiketi kalkar.
QWEN_PAID=true

# Sunucusu ara sertifikasını göndermeyen kurum içi ağ geçitleri için ek CA sertifikaları
# (PEM, virgülle ayrılmış, studio/ klasörüne göre yol). Sertifika doğrulaması kapatılmaz.
# Örnek: EXTRA_CA_CERTS=certs/geotrust-tls-rsa-ca-g1.pem
EXTRA_CA_CERTS=

# Groq (ücretsiz katman, kredi kartı gerekmez, API verisiyle model eğitmez).
# Anahtar: https://console.groq.com/keys  — model listesi: /openai/v1/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# DeepSeek (OpenAI uyumlu). Varsayılan: DeepSeek'in kendi API'si. Kurum içi bir sunucu
# kullanıyorsanız adresini (genelde .../v1 ile biter) ve sunucudaki model adını yazın.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Ücretsiz erişimse false yapın; arayüzdeki "Ücretli" etiketi kalkar.
DEEPSEEK_PAID=true

# Claude (Anthropic)
ANTHROPIC_API_KEY=

# Varsayılan model. Değiştirmek isterseniz: claude-sonnet-5-5 (daha ucuz), claude-haiku-5-5 (en ucuz)
CLAUDE_MODEL=claude-opus-5-5

# Seslendirme. Boş: en iyisi otomatik seçilir. Türkçede Kızağan (kuruluysa), sonra EMA Lightning, sonra macOS "say";
# biri bir sahnede hata verirse sıradaki dener. kizagan / ema / say = yalnızca o motor, none = seslendirme kapalı.
TTS_ENGINE=
# Kızağan TTS (README'de kurulum). Varsayılanlar: studio/.venv-kizagan/bin/python ve studio/models/Kizagan-TTS-v1.0
KIZAGAN_PYTHON=
KIZAGAN_MODEL=
# Boş: cuda > mps (Apple Silicon) > cpu sırasıyla seçilir.
KIZAGAN_DEVICE=
# Difüzyon adımı (model kartı: 16). Düşürmek hızlandırır, kaliteyi düşürebilir.
KIZAGAN_STEPS=16
# Varsayılan referans ses: modelin kendi örneği (erkek, "Kahya"). Kendi kaydınız (izinli, mono WAV, ~6 sn) için:
KIZAGAN_REFERENCE=
# Bir sese gerçek bir kayıt atamak isterseniz (kullanma izniniz olan, mono WAV); yoksa ses dönüşümüyle türetilir.
KIZAGAN_REF_KADIN=
KIZAGAN_REF_KADIN_OLGUN=
KIZAGAN_REF_ERKEK_KALIN=
KIZAGAN_REF_COCUK=
# EMA Lightning'in Python'u (varsayılan: studio/.venv-tts/bin/python). Kurulum README'de.
EMA_PYTHON=
# cpu (Apple Silicon'da en hızlısı), mps veya cuda
EMA_DEVICE=cpu
# Aynı metin hep aynı tonlamayla okunsun diye sabit seed (sesi değiştirmez).
EMA_SEED=7

# Sistem ffmpeg'i kullanmak isterseniz yolunu verin; boşsa ffmpeg-static paketi kullanılır.
FFMPEG_PATH=

PORT=5174
DATA_DIR=data/projects
